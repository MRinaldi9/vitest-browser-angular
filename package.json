{
  "name": "@wismaz/vitest-browser-angular",
  "version": "1.0.0",
  "private": false,
  "description": "Render Angular components in Vitest Browser Mode",
  "keywords": [
    "angular",
    "browser",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/MRinaldi9/vitest-browser-angular#readme",
  "bugs": {
    "url": "https://github.com/MRinaldi9/vitest-browser-angular/issues"
  },
  "license": "MIT",
  "author": "Marco Rinaldi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRinaldi9/vitest-browser-angular.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./pure": "./dist/pure.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "change": "pnpm change",
    "dev": "tsdown --sourcemap",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "prerelease": "pnpm build",
    "release": "pnpm publish -r --access public",
    "_test": "pnpm build && vitest",
    "test:types": "pnpm _test --run --project types",
    "test:zone": "pnpm _test --run --project zone",
    "test:zoneless": "pnpm _test --run --project zoneless"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@analogjs/vitest-angular": "2.7.0",
    "@angular/build": "^22.1.3",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "rxjs": "~7.8.2",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zone.js": "~0.16.0"
  },
  "peerDependencies": {
    "@analogjs/vite-plugin-angular": "*",
    "@analogjs/vitest-angular": ">=2.1.0",
    "@angular/build": ">=20.0.0 <23.0.0",
    "@angular/common": ">=20.0.0 <23.0.0",
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/platform-browser": ">=20.0.0 <23.0.0",
    "@angular/router": ">=20.0.0 <23.0.0",
    "@vitest/browser": "^2.1.0 || ^3.0.0 || ^4.0.0-0",
    "vitest": "^2.1.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/build": {
      "optional": true
    },
    "@analogjs/vite-plugin-angular": {
      "optional": true
    },
    "@analogjs/vitest-angular": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "version": ">=11.0.0",
      "name": "pnpm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">22.22.3 <23 || >24.15.0 <25 || >26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
