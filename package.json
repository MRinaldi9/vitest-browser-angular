{
  "name": "@mrinaldi/vitest-browser-angular",
  "version": "0.6.2",
  "description": "Render Angular components in Vitest Browser Mode",
  "keywords": [
    "angular",
    "browser",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/MRinaldi9/vitest-browser-angular#readme",
  "bugs": {
    "url": "https://github.com/MRinaldi9/vitest-browser-angular/issues"
  },
  "license": "MIT",
  "author": "Marco Rinaldi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRinaldi9/vitest-browser-angular.git"
  },
  "files": [
    "*.d.ts",
    "*.mjs",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./pure": "./dist/pure.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "change": "changeset",
    "dev": "tsdown --watch --sourcemap",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "release": "changeset publish",
    "release.pkg-pr-new": "pnpm dlx pkg-pr-new publish",
    "test": "vitest"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@changesets/cli": "^2.29.6",
    "@changesets/get-github-info": "^0.6.0",
    "@changesets/types": "^6.1.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "bumpp": "^9.4.2",
    "changelogithub": "^0.13.9",
    "dotenv": "^17.2.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "pkg-pr-new": "^0.0.62",
    "playwright": "^1.61.1",
    "rxjs": "~7.8.2",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "tsx": "^4.17.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zone.js": "~0.16.0",
    "zx": "^8.1.4"
  },
  "peerDependencies": {
    "@analogjs/vite-plugin-angular": "*",
    "@analogjs/vitest-angular": ">=2.1.0",
    "@angular/build": ">=20.0.0 <23.0.0",
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/router": ">=20.0.0 <23.0.0",
    "@vitest/browser": "^2.1.0 || ^3.0.0 || ^4.0.0-0",
    "vitest": "^2.1.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/build": {
      "optional": true
    },
    "@analogjs/vite-plugin-angular": {
      "optional": true
    },
    "@analogjs/vitest-angular": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "version": ">=11.0.0",
      "name": "pnpm",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">22.22.3 <23 || >24.15.0 <25 || >26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
